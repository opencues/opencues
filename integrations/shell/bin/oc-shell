#!/usr/bin/env bash
# shell — launch a tmux-wrapped shell with the OpenCues input box bound.
#
# Always uses our own vendored tmux. The system tmux (/usr/bin/tmux,
# brew tmux, etc.) is NEVER invoked — by absolute path only.
#
# From the user's POV:
#   - Run `shell` from anywhere.
#   - They get their normal $SHELL prompt in the current $PWD.
#   - Press Alt+Shift+↑ to open the OpenCues input box (and capture
#     whatever they were typing at the prompt, if shell-integration
#     is installed).
#   - Press Ctrl+Alt+X (or Alt+Shift+←) to leave; the wrapped tmux
#     session is destroyed and `shell` returns.
#
# Resolution order for the tmux binary:
#   1. $OPENCUES_TMUX (explicit override; useful for tests / packagers)
#   2. ~/.opencues/vendor/tmux/bin/tmux (built by `oc-install-tmux`)
#   ─── nothing else ───
#
# PATH is intentionally NOT consulted. If the vendored binary isn't
# present, `shell` exits with a clear "run oc-install-tmux" message.

set -u

# Resolve through symlinks so `~/.local/bin/shell -> .../integrations/terminal/bin/shell`
# still finds ../conf/oc-shell.tmux.conf relative to the REAL script location.
SCRIPT="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
HERE="$(cd -- "$(dirname -- "$SCRIPT")" && pwd)"
CONF="$HERE/../conf/oc-shell.tmux.conf"
VENDOR_TMUX="$HOME/.opencues/vendor/tmux/bin/tmux"
# Resolution order: explicit override → vendored build → system tmux
if [ -n "${OPENCUES_TMUX:-}" ]; then
  OC_TMUX="$OPENCUES_TMUX"
elif [ -x "$VENDOR_TMUX" ]; then
  OC_TMUX="$VENDOR_TMUX"
else
  OC_TMUX="$(command -v tmux 2>/dev/null || echo '')"
fi

# Make the internal helpers (oc-edit, oc-popup, oc-open-input,
# oc-shell-init, oc-editd) visible to the wrapped session even if
# the user invoked `shell` via an absolute path (no PATH entry).
# These are private — not user-runnable on their own.
export PATH="$HERE:$PATH"
# Propagate the chosen tmux to internal helpers (which also need to
# invoke tmux for buffer ops against the wrapped server).
export OPENCUES_TMUX="$OC_TMUX"

if [ ! -f "$CONF" ]; then
  echo "shell: missing tmux config at $CONF" >&2
  exit 1
fi

if [ -z "$OC_TMUX" ] || [ ! -x "$OC_TMUX" ]; then
  echo "shell: tmux not found — install it first:" >&2
  echo "  macOS:         brew install tmux" >&2
  echo "  Debian/Ubuntu: sudo apt install tmux" >&2
  echo "  Fedora:        sudo dnf install tmux" >&2
  echo "  Arch:          sudo pacman -S tmux" >&2
  echo "" >&2
  echo "For a private vendored build (optional, avoids system tmux): $HERE/oc-install-tmux" >&2
  exit 1
fi

# Sanity-check the vendored version. We built it ourselves so this
# should always pass — but a packager or override path could differ.
TMUX_VER="$("$OC_TMUX" -V 2>&1 | awk '{print $2}' | sed 's/[^0-9.].*//')"
TMUX_MAJOR="${TMUX_VER%%.*}"
TMUX_MINOR_REST="${TMUX_VER#*.}"
TMUX_MINOR="${TMUX_MINOR_REST%%.*}"
if [ -n "$TMUX_MAJOR" ] && [ -n "$TMUX_MINOR" ]; then
  if [ "$TMUX_MAJOR" -lt 3 ] || { [ "$TMUX_MAJOR" -eq 3 ] && [ "$TMUX_MINOR" -lt 2 ]; }; then
    echo "shell: $OC_TMUX is tmux $TMUX_VER; >= 3.2 required for display-popup." >&2
    echo "  Rebuild: rm -rf ~/.opencues/vendor/tmux && $HERE/oc-install-tmux" >&2
    exit 1
  fi
fi

# ── Nested-tmux: we still spawn OUR tmux on a private socket ────────
# tmux 3.0+ warns when $TMUX is set on launch (it detects nesting).
# Unset it so our private server starts cleanly; the user's outer
# tmux is still there underneath and untouched.
unset TMUX

# ── Daemon: oc-editd ────────────────────────────────────────────────
# Pre-loads ~/.cues/ config so popups skip the file-I/O budget.
# Spawned in the background; killed on session exit via the EXIT trap.
# Failure here is non-fatal: oc-edit falls back to direct fs reads
# when OPENCUES_OCEDITD_SOCK is unset or the socket is unreachable.
DAEMON_PID=""
DAEMON_SOCK=""
if [ -x "$HERE/oc-editd" ] && command -v bun >/dev/null 2>&1; then
  RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
  DAEMON_SOCK="$RUNTIME_DIR/oc-editd-$$.sock"
  export OPENCUES_OCEDITD_SOCK="$DAEMON_SOCK"
  export OPENCUES_USER_CWD="$PWD"
  # nohup-style: daemon survives an accidental SIGHUP from the parent
  # shell; this script's EXIT trap is what actually terminates it.
  "$HERE/oc-editd" --socket "$DAEMON_SOCK" --cwd "$PWD" >/dev/null 2>&1 &
  DAEMON_PID=$!
fi

cleanup_daemon() {
  if [ -n "$DAEMON_PID" ]; then
    # bun runs a launcher + child; signals only reach the child if
    # sent directly. SIGTERM the whole subtree so the daemon's
    # cleanup handler fires (unlink socket, close watchers).
    pkill -TERM -P "$DAEMON_PID" 2>/dev/null || true
    kill -TERM "$DAEMON_PID" 2>/dev/null || true
    wait "$DAEMON_PID" 2>/dev/null || true
  fi
  [ -n "$DAEMON_SOCK" ] && rm -f "$DAEMON_SOCK"
}
trap cleanup_daemon EXIT

# ── Fresh wrap ──────────────────────────────────────────────────────
# Run oc-shell-init as the first pane command. That script wires the
# tmux session and then exec's the user's interactive shell — so the
# pane behaves identically to a plain terminal. All setup happens
# INSIDE the session (after attach), which sidesteps the conf's
# destroy-unattached behaviour we'd otherwise race with.
SOCKET="opencues-$$"
export OPENCUES_OC_EDIT="$HERE/oc-edit"
export OPENCUES_OC_OPEN_INPUT="$HERE/oc-open-input"

# Per-session tempfile that the shell-integration snippet writes the
# captured readline buffer into. oc-edit reads + unlinks it at
# startup so it appears as the textarea's initial text. Pid keeps
# it isolated to this shell instance.
export OPENCUES_LINE_BUF="${XDG_RUNTIME_DIR:-/tmp}/oc-line-$$.buf"
rm -f "$OPENCUES_LINE_BUF"

# Force opentui to assume synchronized output (DEC mode 2026) is
# supported. Without this, opentui's terminal capability detection
# fails (responses to its mode-state queries route to the wrong
# pane, see DAEMON-PLAN.md), so it falls back to non-atomic
# repaints — visible as a flash of the statusline bar each time the
# oc-input pane resizes (activate / deactivate). Forcing the
# capability on lets the renderer batch each frame into a single
# BSU/ESU-bracketed update, eliminating the flash on supporting
# terminals (kitty, wezterm, alacritty 0.13+, mintty, foot, etc.).
export OPENTUI_FORCE_UNICODE=1

# Stay on the main screen instead of entering tmux's alt-screen
# buffer. The slide-pane oc-edit lives inside a dedicated tmux pane,
# so we don't need alt-screen.
export OTUI_USE_ALTERNATE_SCREEN=false

# No `exec` — the EXIT trap above needs to fire on return.
"$OC_TMUX" -L "$SOCKET" -f "$CONF" \
  new-session -A -s main -c "$PWD" "$HERE/oc-shell-init"
