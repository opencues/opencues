{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "cues-core": ["../../packages/cues-core/src/index.ts"],
      "cues-core/*": ["../../packages/cues-core/src/*"],
      "opencues-runtime/dist/adapters/chrome/v1/boot": ["../../packages/opencues-runtime/adapters/chrome/v1/boot.ts"],
      "opencues-runtime/dist/src/adapter": ["../../packages/opencues-runtime/src/adapter.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
