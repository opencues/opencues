{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "cues-core": ["../../packages/cues-core/src/index.ts"],
      "cues-core/*": ["../../packages/cues-core/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
