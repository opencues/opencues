{
  "name": "@opencues/apple-notes",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCues for Apple Notes on macOS — a JXA polling daemon that answers `_`-gated blanks inline in any unlocked note.",
  "main": "dist/daemon.js",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@opencues/core": "workspace:*",
    "@opencues/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0"
  }
}
