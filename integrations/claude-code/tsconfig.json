{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2020"],
    "types": ["node"]
  },
  "include": ["patches/**/*.ts"],
  "exclude": ["**/*.test.ts", "node_modules"]
}
