{
  "name": "@opencues/claude-code",
  "version": "0.2.7",
  "private": true,
  "description": "OpenCues for Claude Code — native AI integration anywhere you type. Model agnostic and fully open source. Inline agents and prompting.",
  "compatibility": {
    "claude-code": "2.1.110 - 2.1.x"
  },
  "bin": {
    "opencues-claude-code": "./bin/install.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "dev-install": "node bin/install.cjs install",
    "dev-uninstall": "node bin/install.cjs uninstall",
    "seed-configs": "node bin/install.cjs seed-configs",
    "prepublishOnly": "node ../../scripts/prepublish-guard.cjs"
  },
  "files": [
    "bin/",
    "patches/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/opencues/opencues",
    "directory": "integrations/claude-code"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
