#!/usr/bin/env bash
# oc-popup-client — FD-passing popup client.
#
# Invoked by bin/oc-popup when $OPENCUES_OCEDITD_SOCK is set. Connects
# to the daemon, borrows a warm render-worker, hands off the popup's
# stdin/stdout/stderr fds, and writes the committed buffer to --out.
#
# Exit codes:
#   0 = success
#   2 = no daemon socket env (parent should fall back to oc-edit)
#   3 = daemon refused borrow (no warm worker)
#   4 = worker reported failure
#   5 = FD-passing / read failure
#   1 = any other fatal

set -u

SCRIPT="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
HERE="$(cd -- "$(dirname -- "$SCRIPT")" && pwd)"
TERM_DIR="$(cd -- "$HERE/.." && pwd)"
DIST_ENTRY="$TERM_DIR/dist/popup-client.js"
SRC_ENTRY="$TERM_DIR/src/popup-client.ts"

if [ -f "$DIST_ENTRY" ]; then
  ENTRY="$DIST_ENTRY"
elif [ -f "$SRC_ENTRY" ]; then
  ENTRY="$SRC_ENTRY"
else
  echo "oc-popup-client: entry not found" >&2
  exit 1
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "oc-popup-client: bun not on PATH" >&2
  exit 127
fi

cd "$TERM_DIR"
exec bun "$ENTRY" "$@"
