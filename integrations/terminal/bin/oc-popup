#!/usr/bin/env bash
# oc-popup — runs inside a tmux display-popup. Invokes oc-edit and,
# on a successful commit, bracket-pastes the result into the
# originating pane (the pane that was active when Ctrl+Alt+X fired).
#
# Usage: invoked by tmux display-popup with ORIGIN_PANE in env
# (set via `-e ORIGIN_PANE=#{pane_id}` in the keybinding). Earlier
# versions passed the pane id as $1, but tmux's `#{pane_id}` format
# expansion isn't reliable inside quoted shell-command arguments —
# `-e KEY=VALUE` expansion is. Kept reading from $1 too as fallback
# for any local hand-invocations.
#
# Why bracket-paste (paste-buffer -p) instead of send-keys -l:
#   - Preserves multi-line text without each newline triggering
#     command execution in the shell.
#   - Modern bash/zsh/fish respect bracketed paste — the pasted
#     block lands at the prompt as a single editable chunk.
#
# Lifecycle:
#   - tmux opens this script in a display-popup with `-E`, which
#     closes the popup when oc-popup exits.
#   - On Ctrl+S in oc-edit: text written to tmpfile, popup closes,
#     bracket-paste fires.
#   - On Ctrl+C / Esc / empty buffer: tmpfile is empty or missing,
#     nothing is pasted.

set -u

# Prefer the env var set by `display-popup -e ORIGIN_PANE=#{pane_id}`.
# Fall back to $1 for hand-invocations / tests.
ORIGIN_PANE="${ORIGIN_PANE:-${1:-}}"
TMPFILE="$(mktemp -t oc-popup.XXXXXX)"
trap 'rm -f "$TMPFILE"' EXIT

# Resolve through symlinks so a symlinked oc-popup still finds its sibling oc-edit.
SCRIPT="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
HERE="$(cd -- "$(dirname -- "$SCRIPT")" && pwd)"
if [ -x "$HERE/oc-edit" ]; then
  OC_EDIT="$HERE/oc-edit"
else
  OC_EDIT="$(command -v oc-edit 2>/dev/null || true)"
fi

if [ -z "${OC_EDIT:-}" ]; then
  echo "oc-popup: oc-edit not found on PATH or in sibling bin/" >&2
  sleep 2
  exit 127
fi

# Use the same vendored tmux oc-shell exported. We must NOT
# PATH-resolve `tmux` here — the system tmux's client speaks a
# different protocol than our vendored server (different versions),
# and the user explicitly opted out of system-tmux involvement.
# Resolved BEFORE oc-edit runs so the diagnostic block below can
# reference it (set -u would otherwise abort on an unbound ref).
TMUX_BIN="${OPENCUES_TMUX:-$HOME/.opencues/vendor/tmux/bin/tmux}"
if [ ! -x "$TMUX_BIN" ]; then
  echo "oc-popup: vendored tmux not found at $TMUX_BIN" >&2
  sleep 2
  exit 1
fi

"$OC_EDIT" --out "$TMPFILE" || true

# Diagnostic — remove once stable. Lands in /tmp/opencues.log along
# with the runtime logs from the same oc-edit run, so a tail of that
# file shows the whole popup lifecycle.
{
  echo "[$(date '+%Y-%m-%dT%H:%M:%S%z')][oc-popup] tmpfile=$TMPFILE size=$(stat -c %s "$TMPFILE" 2>/dev/null || echo NA) origin=$ORIGIN_PANE tmux=$TMUX_BIN"
  if [ -s "$TMPFILE" ]; then
    echo "[$(date '+%Y-%m-%dT%H:%M:%S%z')][oc-popup] first-80-chars: $(head -c 80 "$TMPFILE" | tr '\n' ' ')"
  fi
} >> /tmp/opencues.log 2>&1 || true

# Inject only if oc-edit committed text AND we have a pane target.
#
# Three paste modes via OPENCUES_POPUP_PASTE_MODE:
#   - bracketed (default): paste-buffer -p. Shell holds the block as
#     one editable chunk; newlines do NOT execute. Best for prose
#     and multi-line drafts in a shell prompt.
#     Caveat: rich TUIs (Claude Code, vim, etc.) detect bracketed
#     paste and collapse it to a "[paste]" placeholder.
#   - typed: send-keys -l. Each character is sent as a literal
#     keystroke — TUIs see it as typed input, no paste collapse.
#     Caveat: every `\n` becomes Enter. In a shell prompt each
#     line executes; in Claude Code each `\n` submits the message.
#     Best for short single-line snippets.
#   - raw: paste-buffer (no -p). Like bracketed but each `\n` is
#     Enter. Best for shell scripts you actually want line-execute.
MODE="${OPENCUES_POPUP_PASTE_MODE:-bracketed}"
if [ -n "$ORIGIN_PANE" ] && [ -s "$TMPFILE" ]; then
  case "$MODE" in
    typed)
      # send-keys -l takes the text via args. Read tmpfile into a
      # variable; tmux sends each char literally. Strip a single
      # trailing newline so the popup's `+ '\n'` from app.tsx
      # doesn't auto-submit at the receiving end.
      TEXT="$(cat "$TMPFILE")"
      if ! "$TMUX_BIN" send-keys -t "$ORIGIN_PANE" -l "$TEXT" 2>>/tmp/opencues.log; then
        echo "[$(date '+%Y-%m-%dT%H:%M:%S%z')][oc-popup] send-keys FAILED (origin=$ORIGIN_PANE)" >> /tmp/opencues.log
      fi
      ;;
    bracketed|raw|*)
      if ! "$TMUX_BIN" load-buffer -b oc-popup "$TMPFILE" 2>>/tmp/opencues.log; then
        echo "[$(date '+%Y-%m-%dT%H:%M:%S%z')][oc-popup] load-buffer FAILED" >> /tmp/opencues.log
      fi
      PASTE_FLAGS=(-b oc-popup -t "$ORIGIN_PANE")
      if [ "$MODE" != "raw" ]; then
        PASTE_FLAGS=(-p "${PASTE_FLAGS[@]}")
      fi
      if ! "$TMUX_BIN" paste-buffer "${PASTE_FLAGS[@]}" 2>>/tmp/opencues.log; then
        echo "[$(date '+%Y-%m-%dT%H:%M:%S%z')][oc-popup] paste-buffer FAILED (origin=$ORIGIN_PANE)" >> /tmp/opencues.log
      fi
      "$TMUX_BIN" delete-buffer -b oc-popup 2>/dev/null || true
      ;;
  esac
  echo "[$(date '+%Y-%m-%dT%H:%M:%S%z')][oc-popup] paste sequence done (mode=$MODE)" >> /tmp/opencues.log
else
  echo "[$(date '+%Y-%m-%dT%H:%M:%S%z')][oc-popup] skipped paste (origin='$ORIGIN_PANE' file_empty=$([ -s "$TMPFILE" ] && echo no || echo yes))" >> /tmp/opencues.log
fi
