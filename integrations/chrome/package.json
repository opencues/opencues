{
  "name": "@opencues/chrome",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCues Chrome MV3 extension — real-time word alternatives, blanks, and cue-controls in the browser.",
  "compatibility": {
    "chrome": ">=121"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dev": "vitest",
    "build": "npm run typecheck && npm test && node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch"
  },
  "dependencies": {
    "@opencues/core": "workspace:*",
    "@opencues/runtime": "workspace:*"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@types/chrome": "^0.0.268",
    "esbuild": "^0.21.0",
    "jsdom": "^29.0.2",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/opencues/opencues",
    "directory": "integrations/chrome"
  }
}
