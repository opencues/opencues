{
  "name": "@opencues/chrome",
  "version": "0.2.173",
  "license": "Apache-2.0",
  "private": true,
  "description": "OpenCues enables native AI integration anywhere you type. Model agnostic and fully open source. Inline agents and prompting.",
  "compatibility": {
    "chrome": ">=121"
  },
  "type": "module",
  "bin": {
    "opencues-chrome": "./bin/install.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dev": "vitest",
    "test:e2e": "playwright test",
    "prebuild": "pnpm --filter @opencues/core --filter @opencues/runtime build",
    "build": "npm run typecheck && npm test && node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "dev-install": "node bin/install.cjs install",
    "dev-uninstall": "node bin/install.cjs uninstall",
    "prepublishOnly": "node ../../scripts/prepublish-guard.cjs",
    "test:e2e:chrome": "playwright test -c playwright.ext.config.ts"
  },
  "dependencies": {
    "@opencues/core": "workspace:*",
    "@opencues/runtime": "workspace:*"
  },
  "devDependencies": {
    "@lexical/history": "^0.44.0",
    "@lexical/plain-text": "^0.44.0",
    "@lexical/utils": "^0.44.0",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.0.268",
    "@types/draft-js": "^0.11.20",
    "@types/react": "^17.0.92",
    "@types/react-dom": "^17.0.26",
    "draft-js": "^0.11.7",
    "esbuild": "^0.25.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.0.2",
    "lexical": "^0.44.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.7",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.8",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "typescript": "^5.4.0",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/opencues/opencues",
    "directory": "integrations/chrome"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
