{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2022"],
    "types": ["node", "react"]
  },
  "include": ["patches/**/*.ts"],
  "exclude": ["**/*.test.ts", "node_modules"]
}
