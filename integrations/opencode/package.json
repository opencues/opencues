{
  "name": "@opencues/opencode",
  "version": "0.1.1",
  "private": true,
  "description": "OpenCues for OpenCode \u2014 patches an OpenCode TUI fork to add real-time word alternatives, blanks, and cue-controls.",
  "compatibility": {
    "opencode": "1.4.x"
  },
  "bin": {
    "opencues-opencode": "./bin/install.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "dev-install": "node bin/install.cjs install",
    "dev-uninstall": "node bin/install.cjs uninstall",
    "seed-configs": "node bin/install.cjs seed-configs",
    "prepublishOnly": "node ../../scripts/prepublish-guard.cjs"
  },
  "files": [
    "bin/",
    "patches/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/opencues/opencues",
    "directory": "integrations/opencode"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
