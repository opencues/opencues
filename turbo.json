{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "!dist/version.json"]
    },
    "@opencues/dsh#build": {
      "dependsOn": ["^build"],
      "outputs": ["client.js", "default-opencues.md"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build", "^build"]
    }
  }
}
