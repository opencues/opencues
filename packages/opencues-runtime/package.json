{
  "name": "@opencues/runtime",
  "version": "0.28.11",
  "description": "Host-agnostic runtime for OpenCues. Hosts implement HostAdapter; runtime owns all feature logic.",
  "private": true,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencues/opencues.git",
    "directory": "packages/opencues-runtime"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && mkdir -p dist/src/user-blanks && cp src/user-blanks/subprocess-runner.cjs dist/src/user-blanks/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dev": "vitest",
    "prepublishOnly": "node ../../scripts/prepublish-guard.cjs"
  },
  "dependencies": {
    "@opencues/core": "workspace:*",
    "acorn": "^8.12.1",
    "acorn-walk": "^8.3.3",
    "isolated-vm": "^6.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.0"
  },
  "license": "Apache-2.0"
}
