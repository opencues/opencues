{
  "name": "@opencues/runtime",
  "version": "0.1.2",
  "description": "Host-agnostic runtime for OpenCues. Hosts implement HostAdapter; runtime owns all feature logic.",
  "private": true,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencues/opencues.git",
    "directory": "packages/opencues-runtime"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dev": "vitest",
    "prepublishOnly": "node ../../scripts/prepublish-guard.cjs"
  },
  "dependencies": {
    "acorn": "^8.12.1",
    "acorn-walk": "^8.3.3",
    "@opencues/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.0"
  },
  "license": "UNLICENSED"
}
