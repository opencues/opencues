{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": false,
    "inlineSourceMap": true,
    "inlineSources": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  // Vitest-style test files import from 'vitest' and crash under the
  // node:test loader when compiled into dist. Exclude them from the
  // build — vitest reads them directly from src/. Pattern matches the
  // explicit list in vitest.config.ts include[]. node:test-style tests
  // (import from 'node:test') are NOT excluded — they're compiled to
  // dist and `npm test` (find dist -name '*.test.js' | xargs node --test)
  // picks them up.
  "exclude": [
    "node_modules",
    "dist",
    "src/feature-registry.test.ts",
    "src/feature-registry-menu.drift.test.ts",
    "src/llm-provider.drift.test.ts",
    "src/conformance.test.ts",
    "src/sources/fluid-blank-error-substitute.test.ts",
    "src/segment.test.ts",
    "src/sources/blank-source.test.ts",
    "src/sources/missing-key-fallback-source.test.ts",
    "src/session-commitments.test.ts",
    "src/contradiction/session-contradiction-source.test.ts",
    "src/sources/tool-prompt-source.test.ts",
    "src/sources/session-cue-source.test.ts"
  ]
}
