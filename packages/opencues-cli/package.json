{
  "name": "opencues",
  "version": "0.8.0",
  "license": "Apache-2.0",
  "description": "OpenCues enables native AI integration anywhere you type. Model agnostic and fully open source. Inline agents and prompting.",
  "keywords": [
    "ai",
    "llm",
    "inline-ai",
    "autocomplete",
    "cli",
    "prompt",
    "prompt-engineering",
    "ai-agents",
    "agentic-ai",
    "writing-assistant",
    "developer-tools",
    "open-standard",
    "open-source",
    "claude",
    "claude-code",
    "anthropic",
    "openai",
    "chatgpt",
    "gemini",
    "groq",
    "cerebras",
    "gpt-oss",
    "chrome-extension",
    "opencues"
  ],
  "bin": {
    "opencues": "./bin/cli.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "_": "node bin/cli.cjs",
    "test": "node --test src/lib/*.test.cjs src/commands/*.test.cjs",
    "test:integration": "node --test src/lib/*.integration.test.cjs src/commands/*.integration.test.cjs",
    "prepublishOnly": "node ../../scripts/prepublish-guard.cjs"
  },
  "files": [
    "bin/",
    "src/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/opencues/opencues",
    "directory": "packages/opencues-cli"
  },
  "dependencies": {
    "enquirer": "^2.4.1"
  }
}
