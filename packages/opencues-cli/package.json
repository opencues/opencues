{
  "name": "opencues",
  "version": "0.2.32",
  "private": true,
  "description": "OpenCues — single-command front door for installing, configuring, and launching OpenCues across all editor integrations.",
  "bin": {
    "opencues": "./bin/cli.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "_": "node bin/cli.cjs",
    "test": "node --test src/lib/*.test.cjs src/commands/*.test.cjs",
    "test:integration": "node --test src/lib/*.integration.test.cjs src/commands/*.integration.test.cjs",
    "prepublishOnly": "node ../../scripts/prepublish-guard.cjs"
  },
  "files": [
    "bin/",
    "src/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/opencues/opencues",
    "directory": "packages/opencues-cli"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "dependencies": {
    "enquirer": "^2.4.1"
  }
}
