{
  "description": "Each word goes to exactly one source — the highest-priority match wins",
  "sources": [
    { "name": "legal",    "priority": 70, "match": "contract|clause|agreement" },
    { "name": "medical",  "priority": 70, "match": "diagnosis|symptom|patient" },
    { "name": "catchall", "priority": 10, "match": ".*" }
  ],
  "expectations": [
    { "word": "contract",  "routesTo": "legal" },
    { "word": "clause",    "routesTo": "legal" },
    { "word": "agreement", "routesTo": "legal" },
    { "word": "diagnosis", "routesTo": "medical" },
    { "word": "symptom",   "routesTo": "medical" },
    { "word": "patient",   "routesTo": "medical" },
    { "word": "hello",     "routesTo": "catchall" },
    { "word": "world",     "routesTo": "catchall" },
    { "word": "lawyer",    "routesTo": "catchall" }
  ]
}
