{
  "description": "Each word goes to exactly one source — the highest-priority match wins",
  "sources": [
    { "name": "concise",  "priority": 70, "match": "contract|clause|agreement" },
    { "name": "plain",    "priority": 70, "match": "diagnosis|symptom|patient" },
    { "name": "catchall", "priority": 10, "match": ".*" }
  ],
  "expectations": [
    { "word": "contract",  "routesTo": "concise" },
    { "word": "clause",    "routesTo": "concise" },
    { "word": "agreement", "routesTo": "concise" },
    { "word": "diagnosis", "routesTo": "plain" },
    { "word": "symptom",   "routesTo": "plain" },
    { "word": "patient",   "routesTo": "plain" },
    { "word": "hello",     "routesTo": "catchall" },
    { "word": "world",     "routesTo": "catchall" },
    { "word": "lawyer",    "routesTo": "catchall" }
  ]
}
