#!/usr/bin/env bash
# oc-pid — find the PID of a running agentic-armed host.
#
# Usage:
#   oc-pid [<host>]
#
# Without an arg, prints all matching PIDs (one per line). With a host
# name (claude-code | opencode | gemini-cli), filters to that host.
#
# How it works:
#   1. Fast path — read /tmp/opencues-agentic.pid (single canonical
#      pidfile written by the harness on arm). One armed host is the
#      common case; this returns instantly without any glob.
#   2. Discovery fallback — list /tmp/opencues-status-<pid>.json files
#      (Statusline writes one per running host) and verify each pid is
#      still alive. Necessary when multiple hosts are armed simultaneously,
#      or when the canonical pidfile was wiped (oversight, reboot, etc.).
#
# Override the canonical pidfile path with OPENCUES_AGENTIC_PID_FILE —
# matches the env var the harness honours.
#
# Examples:
#   oc-pid                  # all live opencues PIDs
#   oc-pid claude-code      # just CC
#   oc-pid opencode

set -euo pipefail

HOST_FILTER="${1:-}"
PID_FILE="${OPENCUES_AGENTIC_PID_FILE:-/tmp/opencues-agentic.pid}"

# Fast path: the canonical pidfile.
if [[ -z "$HOST_FILTER" && -f "$PID_FILE" ]]; then
  pid="$(tr -d '[:space:]' < "$PID_FILE")"
  if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
    echo "$pid"
    exit 0
  fi
  # Stale pidfile — fall through to discovery.
fi

# Status files are written more frequently than dumps, so prefer them
# as the discovery surface (a host that hasn't been told to dump yet
# still has a status file).
shopt -s nullglob
PIDS=()
for f in /tmp/opencues-status-*.json; do
  base="$(basename "$f")"
  pid="${base#opencues-status-}"
  pid="${pid%.json}"
  if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
    if [[ -z "$HOST_FILTER" ]]; then
      PIDS+=("$pid")
    else
      # Confirm the host matches via the dump file (if it exists).
      DUMP="/tmp/opencues-agentic-dump-${pid}.json"
      if [[ -f "$DUMP" ]] && command -v jq &>/dev/null; then
        host="$(jq -r .host < "$DUMP" 2>/dev/null || true)"
        if [[ "$host" == "$HOST_FILTER" ]]; then
          PIDS+=("$pid")
        fi
      else
        # No dump yet — fall back to "include and let caller verify."
        # Better than missing a live host that hasn't been dumped.
        PIDS+=("$pid")
      fi
    fi
  fi
done

if [[ ${#PIDS[@]} -eq 0 ]]; then
  echo "no agentic-armed host found${HOST_FILTER:+ for '$HOST_FILTER'}" >&2
  echo "did you launch with OPENCUES_AGENTIC=1?" >&2
  exit 1
fi

printf '%s\n' "${PIDS[@]}"
