#!/usr/bin/env bash
# oc-tail — tail the OpenCues runtime log.
#
# Usage:
#   oc-tail [-n <lines>] [--grep <pattern>] [--follow]
#
# Sources /tmp/opencues.log. With --follow, runs `tail -f` continuously.
# With --grep, filters lines through a regex.
#
# Examples:
#   oc-tail                          # last 50 lines
#   oc-tail -n 200                   # last 200 lines
#   oc-tail --grep agentic           # filter to agentic harness lines
#   oc-tail --grep 'cycle\|highlight' --follow

set -euo pipefail

LOG="/tmp/opencues.log"
LINES=50
GREP=""
FOLLOW=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n) LINES="$2"; shift 2;;
    --grep) GREP="$2"; shift 2;;
    --follow|-f) FOLLOW=1; shift;;
    *) echo "unknown flag: $1" >&2; exit 2;;
  esac
done

if [[ ! -f "$LOG" ]]; then
  echo "no log at $LOG — host hasn't logged yet (or wrong path)" >&2
  exit 1
fi

if [[ "$FOLLOW" = "1" ]]; then
  if [[ -n "$GREP" ]]; then
    tail -f "$LOG" | grep --line-buffered -E "$GREP"
  else
    tail -f "$LOG"
  fi
else
  if [[ -n "$GREP" ]]; then
    tail -n "$LINES" "$LOG" | grep -E "$GREP" || true
  else
    tail -n "$LINES" "$LOG"
  fi
fi
