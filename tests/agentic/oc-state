#!/usr/bin/env bash
# oc-state — read the current runtime state for a host PID.
#
# Usage:
#   oc-state <pid> [--watch] [--field <jq-path>]
#
# Without --field, prints the full statusline export JSON. With --field,
# prints just that path (uses jq).
#
# Sources:
#   /tmp/opencues-status-<pid>.json   highlighted word, alts, tip, agent task
#   /tmp/opencues-cursor-state-<pid>.json   text + cursor offset
#
# For the richer dump (dynDefs, spanFill, selectorSatellite, etc.),
# use:  oc-inject <pid> dump  &&  oc-dump <pid>
#
# Examples:
#   oc-state 12345
#   oc-state 12345 --field .highlightedWord
#   oc-state 12345 --watch                  # poll every 300ms

set -euo pipefail

if [[ $# -lt 1 ]]; then
  cat >&2 <<EOF
Usage: oc-state <pid> [--watch] [--field <jq-path>]

Reads /tmp/opencues-status-<pid>.json. With --field, extracts a single
JSON path via jq. With --watch, polls every 300ms and prints diffs.
EOF
  exit 2
fi

PID="$1"; shift
# Canonical path first; fall back to legacy opencode-prefixed path for
# host installs that haven't been redeployed since the rename.
STATUS_FILE="/tmp/opencues-status-${PID}.json"
if [[ ! -f "$STATUS_FILE" && -f "/tmp/opencues-opencode-status-${PID}.json" ]]; then
  STATUS_FILE="/tmp/opencues-opencode-status-${PID}.json"
fi
WATCH=0
FIELD=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --watch) WATCH=1; shift;;
    --field) FIELD="$2"; shift 2;;
    *) echo "unknown flag: $1" >&2; exit 2;;
  esac
done

print_state() {
  if [[ ! -f "$STATUS_FILE" ]]; then
    echo "no status file at $STATUS_FILE — host not running, or harness not yet emitted a snapshot" >&2
    return 1
  fi
  if [[ -n "$FIELD" ]]; then
    if ! command -v jq &>/dev/null; then
      echo "jq required for --field" >&2
      return 1
    fi
    jq -r "$FIELD" < "$STATUS_FILE"
  else
    if command -v jq &>/dev/null; then
      jq . < "$STATUS_FILE"
    else
      cat "$STATUS_FILE"
    fi
  fi
}

if [[ "$WATCH" = "1" ]]; then
  LAST=""
  while true; do
    NOW="$(print_state 2>/dev/null || true)"
    if [[ "$NOW" != "$LAST" ]]; then
      printf '\n=== %s ===\n%s\n' "$(date +%H:%M:%S.%3N)" "$NOW"
      LAST="$NOW"
    fi
    sleep 0.3
  done
else
  print_state
fi
