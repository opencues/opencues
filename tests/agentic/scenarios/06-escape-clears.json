{
  "name": "Escape deactivates the highlight without changing text",
  "host": "any",
  "description": "When a cue is active and the user presses Escape, highlight goes inactive but the buffer text stays unchanged.",
  "steps": [
    {"action": "clear"},
    {"action": "inject", "text": "the lawyer filed today"},
    {"action": "waitFor", "path": "active", "equals": true, "timeoutMs": 8000},
    {"action": "key", "key": "escape"},
    {"action": "waitFor", "path": "active", "equals": false, "timeoutMs": 1000},
    {"action": "dump"},
    {"action": "expect", "path": "text", "equals": "the lawyer filed today", "source": "dump"}
  ]
}
