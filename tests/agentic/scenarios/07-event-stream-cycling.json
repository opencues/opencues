{
  "name": "tips cue cycle — assertions via event stream",
  "host": "any",
  "description": "Same flow as 01-basic-cycling but asserts on events (point-in-time facts) rather than derived state. More precise for timing-sensitive paths — e.g. proving a specific transition fired without polling for a state predicate that might already have moved past.",
  "steps": [
    {"action": "clear"},
    {"action": "inject", "text": "we should ultrathink this approach"},
    {"action": "expectEvent", "type": "text.injected", "path": "text", "equals": "we should ultrathink this approach"},
    {"action": "key", "key": "right", "modifiers": ["ctrl", "alt"]},
    {"action": "waitForEvent", "type": "highlight.activated", "path": "word", "equals": "ultrathink", "timeoutMs": 3000},
    {"action": "key", "key": "up", "modifiers": ["ctrl", "alt"]},
    {"action": "waitForEvent", "type": "text.changed", "path": "text", "matches": "Tab", "timeoutMs": 2000},
    {"action": "expect", "path": "currentAltIndex", "equals": 1},
    {"action": "expect", "path": "highlightedWord", "equals": "Tab"}
  ]
}
