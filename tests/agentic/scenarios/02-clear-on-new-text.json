{
  "name": "highlight deactivates when buffer is replaced",
  "host": "any",
  "description": "Activate a highlight, then inject new text — Navigation should deactivate the highlight when the buffer changes from a 'user' source.",
  "steps": [
    {"action": "clear"},
    {"action": "inject", "text": "we should ultrathink this approach"},
    {"action": "key", "key": "right", "modifiers": ["ctrl", "alt"]},
    {"action": "waitForEvent", "type": "highlight.activated", "timeoutMs": 3000},
    {"action": "waitForEvent", "type": "statusline.snapshot", "timeoutMs": 1000},
    {"action": "expect", "path": "active", "equals": true},
    {"action": "inject", "text": "completely different sentence about cats"},
    {"action": "waitForEvent", "type": "highlight.deactivated", "timeoutMs": 2000}
  ]
}
