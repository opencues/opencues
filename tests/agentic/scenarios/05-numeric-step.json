{
  "name": "numeric step cue — 5f cycles 5f → 5.5f → 6f → 5.5f → 5f → 4.5f",
  "host": "any",
  "description": "Mathematical cue-blank — '5f' is a step value. Up/Down should increment/decrement by 0.5. Floors at 0f.",
  "steps": [
    {"action": "clear"},
    {"action": "inject", "text": "set the value to 5f"},
    {"action": "waitFor", "path": "highlightedWord", "equals": "5f", "timeoutMs": 3000},
    {"action": "key", "key": "up", "modifiers": ["ctrl", "alt"]},
    {"action": "dump"},
    {"action": "expect", "path": "text", "matches": "5.5f", "source": "dump"},
    {"action": "key", "key": "up", "modifiers": ["ctrl", "alt"]},
    {"action": "dump"},
    {"action": "expect", "path": "text", "matches": "6f", "source": "dump"},
    {"action": "key", "key": "down", "modifiers": ["ctrl", "alt"]},
    {"action": "key", "key": "down", "modifiers": ["ctrl", "alt"]},
    {"action": "key", "key": "down", "modifiers": ["ctrl", "alt"]},
    {"action": "dump"},
    {"action": "expect", "path": "text", "matches": "4.5f", "source": "dump"}
  ]
}
