{
  "name": "numeric step cue — 5f cycles 5f → 5.5f → 6f",
  "host": "any",
  "description": "Mathematical cue-blank — '5f' is a step value. Up/Down increment/decrement by 0.5. Floors at 0f. Requires navigation to activate the highlight first.",
  "steps": [
    {"action": "clear"},
    {"action": "inject", "text": "set the value to 5f"},
    {"action": "key", "key": "right", "modifiers": ["ctrl", "alt"]},
    {"action": "key", "key": "right", "modifiers": ["ctrl", "alt"]},
    {"action": "key", "key": "right", "modifiers": ["ctrl", "alt"]},
    {"action": "key", "key": "right", "modifiers": ["ctrl", "alt"]},
    {"action": "waitForEvent", "type": "highlight.activated", "path": "word", "equals": "5f", "timeoutMs": 3000},
    {"action": "key", "key": "up", "modifiers": ["ctrl", "alt"]},
    {"action": "waitForEvent", "type": "text.changed", "path": "text", "matches": "5.5f", "timeoutMs": 2000},
    {"action": "key", "key": "up", "modifiers": ["ctrl", "alt"]},
    {"action": "waitForEvent", "type": "text.changed", "path": "text", "matches": "6f", "timeoutMs": 2000}
  ]
}
