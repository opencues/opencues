#!/usr/bin/env bash
# oc-events — read or tail the agentic event stream.
#
# Usage:
#   oc-events <pid> [--type <event-type>] [--follow]
#
# Reads /tmp/opencues-events-<pid>.jsonl. Each line is one JSON event:
#   {"ts": <ms>, "v": <schema>, "pid": <n>, "body": {"type": "...", ...}}
#
# Options:
#   --type <name>   Filter to one body.type (or comma-separated list).
#                   Examples: command | text.injected | highlight.activated
#   --follow        tail -f mode — emit new lines as they're appended.
#   --since <ts>    Skip events with ts < this value (ms-since-epoch).
#                   Useful for "show me what happened after I did X".
#
# Examples:
#   oc-events 12345
#   oc-events 12345 --type highlight.activated,highlight.word-changed
#   oc-events 12345 --follow --type text.changed
#   oc-events 12345 --since 1778340000000

set -euo pipefail

if [[ $# -lt 1 ]]; then
  cat >&2 <<EOF
Usage: oc-events <pid> [--type <name>[,<name>...]] [--follow] [--since <ts>]

Reads /tmp/opencues-events-<pid>.jsonl. One JSON event per line.

Use OPENCUES_AGENTIC_EVENTS_FILE to override the path on read (must
match the override the host was launched with).
EOF
  exit 2
fi

PID="$1"; shift
EVENTS_FILE="${OPENCUES_AGENTIC_EVENTS_FILE:-/tmp/opencues-events-${PID}.jsonl}"
TYPE_FILTER=""
FOLLOW=0
SINCE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --type)   TYPE_FILTER="$2"; shift 2;;
    --follow|-f) FOLLOW=1; shift;;
    --since)  SINCE="$2"; shift 2;;
    *) echo "unknown flag: $1" >&2; exit 2;;
  esac
done

if [[ ! -f "$EVENTS_FILE" ]]; then
  echo "no events file at $EVENTS_FILE — host not running, or harness not armed (set OPENCUES_AGENTIC=1)" >&2
  exit 1
fi

# Build the jq filter:
#   1. drop entries below --since
#   2. drop entries whose body.type isn't in --type (when set)
#   3. pretty-print one event per line
JQ_FILTER='.'
if [[ -n "$SINCE" ]]; then
  JQ_FILTER="$JQ_FILTER | select(.ts >= ${SINCE})"
fi
if [[ -n "$TYPE_FILTER" ]]; then
  # Convert "a,b,c" → ("a","b","c") — a jq array expression
  TYPES=$(echo "$TYPE_FILTER" | awk -F, '{
    for (i=1; i<=NF; i++) printf "%s\"%s\"", (i>1?",":""), $i
  }')
  JQ_FILTER="$JQ_FILTER | select(.body.type as \$t | [${TYPES}] | index(\$t))"
fi

print_filter() {
  if command -v jq &>/dev/null; then
    jq -c "$JQ_FILTER"
  else
    # No jq fallback — emit raw lines, ignore filters.
    cat
  fi
}

if [[ "$FOLLOW" = "1" ]]; then
  tail -f "$EVENTS_FILE" | print_filter
else
  cat "$EVENTS_FILE" | print_filter
fi
